NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# AI processing remains disabled until tenant processing approval and durable jobs exist.
APP_URL=http://localhost:4000

# Server-only. setup:supabase generates 32 random bytes; preserve across deployments.
INVITATION_TOKEN_SECRET=
# Optional approved HTTPS email adapter. See docs/TEAM_ADMINISTRATION.md for contract.
INVITATION_MAIL_URL=
INVITATION_MAIL_TOKEN=

# Server-only worker credentials. Never expose through NEXT_PUBLIC variables.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only 32-byte hex key for encrypted website signing secrets.
INTAKE_ENCRYPTION_KEY=

# AI stays disabled until platform and tenant approvals, quotas and rubric evaluation.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=
AI_PLATFORM_ENABLED=false
AI_PROCESSING_APPROVED=false
AI_RUBRIC_APPROVED=false
AI_APPROVED_LANGUAGES=

# Enable only after reviewed-reply evaluation/approval; no automatic delivery.
AI_DRAFTS_ENABLED=false

# Optional content-free timing/status logs. No URLs, bodies, identities or secrets.
OPERATIONAL_LOGS_ENABLED=false

# Optional server-only AES read/write key ring. IDs map to 32-byte lowercase hex keys.
# Keep INTAKE_ENCRYPTION_KEY unchanged: legacy decrypt + deterministic signing derivation.
# Active encryption key ID is selected by private DB policy, initially legacy.
INTAKE_ENCRYPTION_KEYS=

# Optional server-only invitation HMAC key ring; immutable IDs map to 32-byte hex keys.
# Keep INVITATION_TOKEN_SECRET for legacy invitation retries, jobs and backups.
# Active ID is selected by private DB policy; initially legacy.
INVITATION_TOKEN_KEYS=

# Optional server-only HMAC derivation roots for new website signing credentials.
# Immutable IDs map to independent 32-byte lowercase hex keys; initial policy is legacy.
# Preserve INTAKE_ENCRYPTION_KEY for legacy root retries, AES reads and backups.
INTAKE_SIGNING_ROOT_KEYS=
